// © Quarterly Correlation Break Strategy

//@version=5
strategy("Quarterly Correlation Break", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1)

// ============================================================================
// INPUTS
// ============================================================================
i_riskAmount = input.float(1000, "Risk Amount ($)", minval=100)
i_tp1Percent = input.float(70, "TP1 Percentage (%)", minval=1, maxval=100)
i_showLines = input.bool(true, "Show Lines")
i_timezone = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "UTC"])

i_esSymbol = input.symbol("CME_MINI:ES1!", "ES Symbol")
i_ymSymbol = input.symbol("CBOT_MINI:YM1!", "YM Symbol")

// ============================================================================
// QUARTER FUNCTIONS
// ============================================================================
getDailyQ(h) =>
    h >= 18 ? 1 : h >= 12 ? 4 : h >= 6 ? 3 : 2

get90MinQ(h, m) =>
    mins = h * 60 + m
    q = 0
    if mins >= 1080 and mins < 1440
        q := int((mins - 1080) / 90) + 1
    else if mins < 360
        q := int(mins / 90) + 1
    else if mins < 720
        q := int((mins - 360) / 90) + 1
    else if mins < 1080
        q := int((mins - 720) / 90) + 1
    math.min(q, 4)

curHour = hour(time, i_timezone)
curMin = minute(time, i_timezone)
dailyQ = getDailyQ(curHour)
minQ = get90MinQ(curHour, curMin)

// ============================================================================
// ES & YM DATA
// ============================================================================
[esO, esH, esL, esC] = request.security(i_esSymbol, timeframe.period, [open, high, low, close])
[ymO, ymH, ymL, ymC] = request.security(i_ymSymbol, timeframe.period, [open, high, low, close])

// ============================================================================
// TRACKING VARIABLES - Previous Quarter
// ============================================================================
var float pQ_lowBody = na
var float pQ_lowWick = na
var float pQ_highBody = na
var float pQ_highWick = na
var int pQ_low90 = 0
var int pQ_high90 = 0

var float pQ_ES_lowBody = na
var float pQ_ES_lowWick = na
var float pQ_ES_highBody = na
var float pQ_ES_highWick = na

var float pQ_YM_lowBody = na
var float pQ_YM_lowWick = na
var float pQ_YM_highBody = na
var float pQ_YM_highWick = na

// ============================================================================
// TRACKING VARIABLES - Current Quarter
// ============================================================================
var float cQ_lowBody = na
var float cQ_lowWick = na
var float cQ_highBody = na
var float cQ_highWick = na
var int cQ_low90 = 0
var int cQ_high90 = 0

var float cQ_ES_lowBody = na
var float cQ_ES_lowWick = na
var float cQ_ES_highBody = na
var float cQ_ES_highWick = na

var float cQ_YM_lowBody = na
var float cQ_YM_lowWick = na
var float cQ_YM_highBody = na
var float cQ_YM_highWick = na

// ============================================================================
// SWEEP TRACKING - czy wykryto sweep i czekamy na zamknięcie
// ============================================================================
var bool longSweepDetected = false
var bool shortSweepDetected = false
var float sweepWickLevel = na
var int sweepBar = 0

// ============================================================================
// QUARTER CHANGE DETECTION
// ============================================================================
qChange = dailyQ != dailyQ[1]

if qChange
    pQ_lowBody := cQ_lowBody
    pQ_lowWick := cQ_lowWick
    pQ_highBody := cQ_highBody
    pQ_highWick := cQ_highWick
    pQ_low90 := cQ_low90
    pQ_high90 := cQ_high90

    pQ_ES_lowBody := cQ_ES_lowBody
    pQ_ES_lowWick := cQ_ES_lowWick
    pQ_ES_highBody := cQ_ES_highBody
    pQ_ES_highWick := cQ_ES_highWick

    pQ_YM_lowBody := cQ_YM_lowBody
    pQ_YM_lowWick := cQ_YM_lowWick
    pQ_YM_highBody := cQ_YM_highBody
    pQ_YM_highWick := cQ_YM_highWick

    cQ_lowBody := na
    cQ_lowWick := na
    cQ_highBody := na
    cQ_highWick := na
    cQ_low90 := 0
    cQ_high90 := 0
    cQ_ES_lowBody := na
    cQ_ES_lowWick := na
    cQ_ES_highBody := na
    cQ_ES_highWick := na
    cQ_YM_lowBody := na
    cQ_YM_lowWick := na
    cQ_YM_highBody := na
    cQ_YM_highWick := na

    // Reset sweep flags przy zmianie kwartału
    longSweepDetected := false
    shortSweepDetected := false

// ============================================================================
// UPDATE MIN/MAX BODY
// ============================================================================
nqLowBody = math.min(open, close)
nqHighBody = math.max(open, close)
esLowBody = math.min(esO, esC)
esHighBody = math.max(esO, esC)
ymLowBody = math.min(ymO, ymC)
ymHighBody = math.max(ymO, ymC)

if na(cQ_lowBody) or nqLowBody < cQ_lowBody
    cQ_lowBody := nqLowBody
    cQ_lowWick := low
    cQ_low90 := minQ

if na(cQ_highBody) or nqHighBody > cQ_highBody
    cQ_highBody := nqHighBody
    cQ_highWick := high
    cQ_high90 := minQ

if na(cQ_ES_lowBody) or esLowBody < cQ_ES_lowBody
    cQ_ES_lowBody := esLowBody
    cQ_ES_lowWick := esL

if na(cQ_ES_highBody) or esHighBody > cQ_ES_highBody
    cQ_ES_highBody := esHighBody
    cQ_ES_highWick := esH

if na(cQ_YM_lowBody) or ymLowBody < cQ_YM_lowBody
    cQ_YM_lowBody := ymLowBody
    cQ_YM_lowWick := ymL

if na(cQ_YM_highBody) or ymHighBody > cQ_YM_highBody
    cQ_YM_highBody := ymHighBody
    cQ_YM_highWick := ymH

// ============================================================================
// EXCLUDED TRANSITIONS
// Q14->Q21, Q24->Q31, Q34->Q41, Q44->Q11
// ============================================================================
isExcluded() =>
    prev90 = minQ[1]
    curr90 = minQ
    prevD = dailyQ[1]
    currD = dailyQ
    ex = false
    if prevD == 1 and currD == 2 and prev90 == 4 and curr90 == 1
        ex := true
    if prevD == 2 and currD == 3 and prev90 == 4 and curr90 == 1
        ex := true
    if prevD == 3 and currD == 4 and prev90 == 4 and curr90 == 1
        ex := true
    if prevD == 4 and currD == 1 and prev90 == 4 and curr90 == 1
        ex := true
    ex

// ============================================================================
// CANDLE ALIGNMENT - poprzednia świeca musi być taka sama na wszystkich
// ============================================================================
nqPrevBull = close[1] > open[1]
esPrevBull = esC[1] > esO[1]
ymPrevBull = ymC[1] > ymO[1]
candlesAligned = (nqPrevBull and esPrevBull and ymPrevBull) or (not nqPrevBull and not esPrevBull and not ymPrevBull)

// ============================================================================
// SWEEP DETECTION - LONG (NQ zbiera low, ES/YM nie)
// ============================================================================
nqSweptLow = not na(pQ_lowWick) and low < pQ_lowWick
esNotSweptLow = na(pQ_ES_lowWick) or esL > pQ_ES_lowWick
ymNotSweptLow = na(pQ_YM_lowWick) or ymL > pQ_YM_lowWick
esBodyOk = na(pQ_ES_lowBody) or esLowBody > pQ_ES_lowBody
ymBodyOk = na(pQ_YM_lowBody) or ymLowBody > pQ_YM_lowBody
same90Low = minQ == pQ_low90

// Wykrycie SWEEP dla LONG
longSweepNow = nqSweptLow and esNotSweptLow and ymNotSweptLow and esBodyOk and ymBodyOk and same90Low and not isExcluded() and candlesAligned

if longSweepNow and not longSweepDetected and not shortSweepDetected
    longSweepDetected := true
    sweepWickLevel := pQ_lowWick
    sweepBar := bar_index

// ============================================================================
// SWEEP DETECTION - SHORT (NQ zbiera high, ES/YM nie)
// ============================================================================
nqSweptHigh = not na(pQ_highWick) and high > pQ_highWick
esNotSweptHigh = na(pQ_ES_highWick) or esH < pQ_ES_highWick
ymNotSweptHigh = na(pQ_YM_highWick) or ymH < pQ_YM_highWick
esBodyOkS = na(pQ_ES_highBody) or esHighBody < pQ_ES_highBody
ymBodyOkS = na(pQ_YM_highBody) or ymHighBody < pQ_YM_highBody
same90High = minQ == pQ_high90

// Wykrycie SWEEP dla SHORT
shortSweepNow = nqSweptHigh and esNotSweptHigh and ymNotSweptHigh and esBodyOkS and ymBodyOkS and same90High and not isExcluded() and candlesAligned

if shortSweepNow and not shortSweepDetected and not longSweepDetected
    shortSweepDetected := true
    sweepWickLevel := pQ_highWick
    sweepBar := bar_index

// ============================================================================
// ENTRY SIGNALS - pierwsza świeca która zamknie się powyżej/poniżej wicka
// ============================================================================
goLong = longSweepDetected and close > sweepWickLevel
goShort = shortSweepDetected and close < sweepWickLevel

// Reset sweep po sygnale
if goLong
    longSweepDetected := false
if goShort
    shortSweepDetected := false

// ============================================================================
// POSITION MANAGEMENT
// ============================================================================
var float myEntry = na
var float mySL = na
var float myTP = na
var bool inPos = false
var bool posLong = false
var bool tp1Done = false

pntVal = syminfo.pointvalue

calcQty(ent, sl, risk) =>
    pts = math.abs(ent - sl)
    rpc = pts * pntVal
    rpc > 0 ? math.max(1, math.round(risk / rpc)) : 1

// LONG ENTRY
if goLong and not inPos and strategy.position_size == 0
    myEntry := close
    mySL := low
    myTP := pQ_highWick
    inPos := true
    posLong := true
    tp1Done := false
    int qty = calcQty(myEntry, mySL, i_riskAmount)
    strategy.entry("L", strategy.long, qty=qty)
    strategy.exit("TPL", "L", limit=myTP, stop=mySL, qty_percent=i_tp1Percent)

// SHORT ENTRY
if goShort and not inPos and strategy.position_size == 0
    myEntry := close
    mySL := high
    myTP := pQ_lowWick
    inPos := true
    posLong := false
    tp1Done := false
    int qty = calcQty(myEntry, mySL, i_riskAmount)
    strategy.entry("S", strategy.short, qty=qty)
    strategy.exit("TPS", "S", limit=myTP, stop=mySL, qty_percent=i_tp1Percent)

// BREAK EVEN
if inPos and not tp1Done
    if posLong and high >= myTP
        tp1Done := true
        strategy.exit("BEL", "L", stop=myEntry)
    if not posLong and low <= myTP
        tp1Done := true
        strategy.exit("BES", "S", stop=myEntry)

// RESET
if strategy.position_size == 0 and inPos
    inPos := false
    myEntry := na
    mySL := na
    myTP := na

// ============================================================================
// VISUALIZATION
// ============================================================================
plot(i_showLines and not na(pQ_lowWick) ? pQ_lowWick : na, "Prev Q Low Wick", color.red, 2)
plot(i_showLines and not na(pQ_highWick) ? pQ_highWick : na, "Prev Q High Wick", color.green, 2)

// Sweep detected marker
plotshape(longSweepNow, "Sweep Low", shape.circle, location.belowbar, color.orange, size=size.small)
plotshape(shortSweepNow, "Sweep High", shape.circle, location.abovebar, color.orange, size=size.small)

// Entry signals
plotshape(goLong, "LONG", shape.triangleup, location.belowbar, color.lime, size=size.large)
plotshape(goShort, "SHORT", shape.triangledown, location.abovebar, color.red, size=size.large)

bgcolor(inPos and posLong ? color.new(color.green, 90) : na)
bgcolor(inPos and not posLong ? color.new(color.red, 90) : na)
bgcolor(longSweepDetected ? color.new(color.orange, 95) : na)
bgcolor(shortSweepDetected ? color.new(color.purple, 95) : na)

// ============================================================================
// DEBUG TABLE
// ============================================================================
var table debugTable = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80))

if barstate.islast
    table.cell(debugTable, 0, 0, "Q:", text_color=color.white)
    table.cell(debugTable, 1, 0, "Q" + str.tostring(dailyQ) + str.tostring(minQ), text_color=color.yellow)
    table.cell(debugTable, 0, 1, "PrevQ Low Wick:", text_color=color.white)
    table.cell(debugTable, 1, 1, str.tostring(pQ_lowWick, "#.##"), text_color=color.red)
    table.cell(debugTable, 0, 2, "PrevQ High Wick:", text_color=color.white)
    table.cell(debugTable, 1, 2, str.tostring(pQ_highWick, "#.##"), text_color=color.green)
    table.cell(debugTable, 0, 3, "Long Sweep:", text_color=color.white)
    table.cell(debugTable, 1, 3, longSweepDetected ? "WAITING" : "NO", text_color=longSweepDetected ? color.orange : color.gray)
    table.cell(debugTable, 0, 4, "Short Sweep:", text_color=color.white)
    table.cell(debugTable, 1, 4, shortSweepDetected ? "WAITING" : "NO", text_color=shortSweepDetected ? color.purple : color.gray)
    table.cell(debugTable, 0, 5, "Sweep Level:", text_color=color.white)
    table.cell(debugTable, 1, 5, str.tostring(sweepWickLevel, "#.##"), text_color=color.orange)
    table.cell(debugTable, 0, 6, "Candles Aligned:", text_color=color.white)
    table.cell(debugTable, 1, 6, candlesAligned ? "YES" : "NO", text_color=candlesAligned ? color.lime : color.red)
    table.cell(debugTable, 0, 7, "Position:", text_color=color.white)
    table.cell(debugTable, 1, 7, inPos ? (posLong ? "LONG" : "SHORT") : "NONE", text_color=color.yellow)
    table.cell(debugTable, 0, 8, "Entry:", text_color=color.white)
    table.cell(debugTable, 1, 8, str.tostring(myEntry, "#.##"), text_color=color.white)
    table.cell(debugTable, 0, 9, "SL:", text_color=color.white)
    table.cell(debugTable, 1, 9, str.tostring(mySL, "#.##"), text_color=color.fuchsia)
    table.cell(debugTable, 0, 10, "TP:", text_color=color.white)
    table.cell(debugTable, 1, 10, str.tostring(myTP, "#.##"), text_color=color.aqua)

alertcondition(goLong, "Long Signal", "LONG")
alertcondition(goShort, "Short Signal", "SHORT")
